# Copy to .env and fill in. NEVER commit .env - it holds your bot token.

# --- Required ---------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=
# Snowflake id of the single Discord server this bot serves.
GUILD_ID=

# --- Transcription metadata --------------------------------------------------
# This host does NOT transcribe. These values travel with the audio, in
# metadata.json, for whichever machine does.

# Transcript language. Occasional English words are handled fine.
TRANSCRIBE_LANGUAGE=tr
# Campaign vocabulary fed to Whisper as a prompt, on top of the character names
# from /character set. The single biggest lever on getting names spelled right.
# WHISPER_PROMPT_EXTRA=Yer isimleri: Neverwinter, Waterdeep. NPC: Volo.

# --- Where the handover happens ----------------------------------------------
# local = a shared filesystem; the transcriber pulls over SSH and needs a Unix
#         account on this host.
# r2    = Cloudflare R2. Both halves talk outbound only, so neither machine has
#         to be reachable by the other and no SSH account is needed. Egress is
#         free, which is what makes pulling gigabytes of audio to a home
#         connection practical.
STORAGE_BACKEND=local

# Only used when STORAGE_BACKEND=r2. The transcriber must point at the SAME
# bucket. Create the token under R2 -> Manage API Tokens with the
# "Object Read & Write" permission, scoped to this one bucket.
# Account ID is on the R2 overview page, not the token page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# How often staged sessions are pushed to R2.
UPLOAD_INTERVAL_SECONDS=120

# --- Handover to an external transcriber -------------------------------------
# Stage finished sessions in DATA_DIR/outbox for the transcriber to collect
# (metadata.json + one audio track per speaker + a READY marker), and post the
# transcripts that come back into DATA_DIR/inbox.
# There is no reason to turn this off: it is the only way a transcript is ever
# produced now.
OUTBOX_ENABLED=true

# --- Storage ----------------------------------------------------------------
# Host directory holding sessions, transcripts, exports and the database.
# Defaults to ./data next to this file. With AUDIO_FORMAT=opus a 4h session
# with 5 players is around 430 MB; with wav the same session is ~14 GB.
# It must be writable by uid 10001: sudo chown -R 10001:10001 <dir>
DATA_HOST_DIR=./data

# Path *inside* the container. Leave this alone; DATA_HOST_DIR is the one to change.
DATA_DIR=/data
# opus (default, ~32x smaller than wav and no measurable accuracy cost - Discord
# already sends Opus, so this mostly undoes an expansion we caused ourselves).
# Keep it: the transcriber reads Opus, and a small VPS cannot hold wav.
AUDIO_FORMAT=opus
# Raw audio is deleted this many days after a successful transcription.
AUDIO_RETENTION_DAYS=7
# Warn when free space on DATA_DIR drops below this. Keep it comfortably above
# the size of one session or the warning arrives too late.
DISK_WARNING_THRESHOLD_MB=5000
# Fallback DM target for disk warnings and fatal startup errors.
ADMIN_USER_ID=

# --- Access control ----------------------------------------------------------
# Starting and stopping a recording is open to whoever is in the voice channel.
# /session transcript, /session export and /session recover are not: they act on
# past sessions and publish their words or raw audio into whatever channel the
# caller is in. Members with Manage Guild can always run them; set a role id
# here to grant them to a role as well (right-click the role -> Copy Role ID).
SESSION_ADMIN_ROLE_ID=
# Exports larger than this are reported as a server path instead of uploaded.
EXPORT_MAX_DISCORD_UPLOAD_MB=25

# --- Timezone ---------------------------------------------------------------
# Used for transcript timestamps and the nightly backup schedule.
TIMEZONE=Europe/Istanbul

# --- Backups ----------------------------------------------------------------
# Daily bot.db copies kept in /data/backups.
DB_BACKUP_KEEP_DAYS=14

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# Container clock for log timestamps. Without it logs are in UTC. Transcript
# timestamps use TIMEZONE above regardless of this setting.
TZ=Europe/Istanbul
