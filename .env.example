# Copy to .env and fill in. NEVER commit .env - it holds your bot token.

# --- Required ---------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=
# Snowflake id of the single Discord server this bot serves.
GUILD_ID=

# --- Transcription metadata --------------------------------------------------
# This host does NOT transcribe. These values travel with the audio, in
# metadata.json, for whichever machine does.

# Transcript language. Occasional English words are handled fine.
TRANSCRIBE_LANGUAGE=tr
# Campaign vocabulary fed to Whisper as a prompt, on top of the character names
# from /character set. The single biggest lever on getting names spelled right.
# WHISPER_PROMPT_EXTRA=Yer isimleri: Neverwinter, Waterdeep. NPC: Volo.

# --- Where the handover happens ----------------------------------------------
# local = a shared filesystem; the transcriber pulls over SSH and needs a Unix
#         account on this host.
# r2    = Cloudflare R2. Both halves talk outbound only, so neither machine has
#         to be reachable by the other and no SSH account is needed. Egress is
#         free, which is what makes pulling gigabytes of audio to a home
#         connection practical.
STORAGE_BACKEND=local

# Only used when STORAGE_BACKEND=r2. The transcriber must point at the SAME
# bucket. Create the token under R2 -> Manage API Tokens with the
# "Object Read & Write" permission, scoped to this one bucket.
# Account ID is on the R2 overview page, not the token page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# How often staged sessions are pushed to R2.
UPLOAD_INTERVAL_SECONDS=120

# --- Handover to an external transcriber -------------------------------------
# Stage finished sessions in DATA_DIR/outbox for the transcriber to collect
# (metadata.json + one audio track per speaker + a READY marker), and post the
# transcripts that come back into DATA_DIR/inbox.
# There is no reason to turn this off: it is the only way a transcript is ever
# produced now.
OUTBOX_ENABLED=true

# --- Storage ----------------------------------------------------------------
# Host directory holding sessions, transcripts, exports and the database.
# Defaults to ./data next to this file. With AUDIO_FORMAT=opus a 4h session
# with 5 players is around 430 MB; with wav the same session is ~14 GB.
# It must be writable by uid 10001: sudo chown -R 10001:10001 <dir>
DATA_HOST_DIR=./data

# Path *inside* the container. Leave this alone; DATA_HOST_DIR is the one to change.
DATA_DIR=/data
# opus (default, ~32x smaller than wav and no measurable accuracy cost - Discord
# already sends Opus, so this mostly undoes an expansion we caused ourselves).
# Keep it: the transcriber reads Opus, and a small VPS cannot hold wav.
AUDIO_FORMAT=opus
# Raw audio is deleted this many days after a successful transcription.
AUDIO_RETENTION_DAYS=7
# A session deleted from the portal waits in the trash this many days, and can
# be restored until then. After that it is removed for good.
TRASH_RETENTION_DAYS=7
# Warn when free space on DATA_DIR drops below this. Keep it comfortably above
# the size of one session or the warning arrives too late.
DISK_WARNING_THRESHOLD_MB=5000
# How long your games run. /session start refuses if the disk cannot hold a
# session this long at the number of people currently in the channel. Raw
# capture is ~0.7 GB per speaker-hour and is only shrunk at /session stop, so
# running out mid-game silently stops the recording - hence the check.
EXPECTED_SESSION_HOURS=4
# Fallback DM target for disk warnings and fatal startup errors.
ADMIN_USER_ID=

# --- Access control ----------------------------------------------------------
# Starting and stopping a recording is open to whoever is in the voice channel.
# /session transcript, /session export and /session recover are not: they act on
# past sessions and publish their words or raw audio into whatever channel the
# caller is in. Members with Manage Guild can always run them; set a role id
# here to grant them to a role as well (right-click the role -> Copy Role ID).
SESSION_ADMIN_ROLE_ID=
# Exports larger than this are reported as a server path instead of uploaded.
EXPORT_MAX_DISCORD_UPLOAD_MB=25

# --- Timezone ---------------------------------------------------------------
# Used for transcript timestamps and the nightly backup schedule.
TIMEZONE=Europe/Istanbul

# --- Backups ----------------------------------------------------------------
# Daily bot.db copies kept in /data/backups.
DB_BACKUP_KEEP_DAYS=14

# --- HTTP API (portal) --------------------------------------------------------
# Off unless you run the portal. Turning it on exposes control of recordings -
# including stopping a live one - to anyone holding API_TOKEN.
API_ENABLED=false
# Bind address INSIDE the container. docker-compose sets this to 0.0.0.0 and
# publishes the port to 127.0.0.1 on the host only, so the sole way in is your
# reverse proxy, which terminates TLS. Never publish this port to the world
# unencrypted: the token travels in a header.
API_HOST=127.0.0.1
API_PORT=8080
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 32 characters. Rotating it means editing this file and restarting;
# there is no revocation list.
API_TOKEN=
# Exact origins the browser may call from, comma-separated. A wildcard is
# refused. Leave empty when the portal calls through its own server, which is
# the recommended setup - the token must never reach browser JavaScript.
API_CORS_ORIGINS=
# Requests per minute per token. Writes to /recording and /music/search are
# capped lower than this regardless.
API_RATE_LIMIT_PER_MINUTE=60
# Channel where the portal posts dice rolls (right-click the channel > Copy ID).
# Optional: without it the portal can only post to a channel it names.
DICE_CHANNEL_ID=

# --- Reliability ----------------------------------------------------------------
# Exit (and let Docker restart the bot) if Discord has not reported ready this
# many seconds after start. Guards against a silent login hang.
READY_TIMEOUT_SECONDS=180

# --- Music --------------------------------------------------------------------
# Play tracks into the voice channel while recording. The bot's own audio is
# never sent back to it, so playback does not land in the speaker tracks - but a
# player without headphones will bleed it into theirs.
MUSIC_ENABLED=false
# Where tracks live in the R2 bucket. Needs STORAGE_BACKEND=r2.
MUSIC_R2_PREFIX=music
# 0.3 keeps music under the voices. 1.0 is full volume, 2.0 the ceiling.
MUSIC_DEFAULT_VOLUME=0.3
MUSIC_MAX_QUEUE=100
# Downloaded tracks are cached under DATA_DIR/music and pruned to this size.
# It shares the disk with raw capture (~0.7 GB per speaker-hour), so keep it
# well under what a session needs.
MUSIC_CACHE_MAX_MB=2000
# Largest file the portal may upload into the music bucket, in MB (1-1000).
# Uploads stream through the data disk, so keep this well below free space.
MUSIC_UPLOAD_MAX_MB=150
# A voice reconnect mid-session replaces the connection and kills playback.
# This restarts the current track roughly where it left off.
MUSIC_RESUME_AFTER_RECONNECT=true
# Streaming from YouTube via yt-dlp. Off by default: it breaks whenever YouTube
# changes, needs frequent updates, and is against their terms of service. The
# package is not in the default image.
MUSIC_YTDLP_ENABLED=false
# How long one link resolution may take before it is killed.
MUSIC_YTDLP_TIMEOUT_SECONDS=20
# Resolutions run as subprocesses. More than a couple at once starves the
# recording on a small host.
MUSIC_YTDLP_MAX_CONCURRENT=2
# YouTube stream URLs are signed and expire. A track older than this is
# re-resolved before it plays, instead of failing on a dead link.
MUSIC_STREAM_TTL_SECONDS=1800
# Refuse tracks longer than this (seconds). Default 3 hours.
MUSIC_MAX_TRACK_SECONDS=10800
# Live streams never end, so anything queued behind one never plays.
MUSIC_ALLOW_LIVE=false
# Ambience and effects from YouTube are downloaded once into the music cache and
# played from disk. These bound one link: longest effect and ambience (seconds),
# largest file (MB), and how long a download may take (seconds).
MUSIC_YT_SFX_MAX_SECONDS=60
MUSIC_YT_AMBIENCE_MAX_SECONDS=1800
MUSIC_YT_LAYER_MAX_MB=40
MUSIC_YT_DOWNLOAD_TIMEOUT_SECONDS=90

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# Container clock for log timestamps. Without it logs are in UTC. Transcript
# timestamps use TIMEZONE above regardless of this setting.
TZ=Europe/Istanbul
