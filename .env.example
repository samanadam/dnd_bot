# Copy to .env and fill in. NEVER commit .env - it holds your bot token.

# --- Required ---------------------------------------------------------------
# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=
# Snowflake id of the single Discord server this bot serves.
GUILD_ID=

# --- Whisper ----------------------------------------------------------------
# medium gives noticeably better Turkish accuracy than small, at the cost of
# speed and memory. First start downloads it into the model cache volume.
WHISPER_MODEL=medium
# cpu, or cuda if you pass a GPU through in docker-compose.yml.
WHISPER_DEVICE=cpu
# int8 on CPU; use float16 on CUDA.
WHISPER_COMPUTE_TYPE=int8
# Fixed transcript language. Occasional English words are handled fine.
TRANSCRIBE_LANGUAGE=tr

# --- Turkish accuracy tuning ------------------------------------------------
# Wider beam = slightly better wording, slower. 5 is a good CPU default.
WHISPER_BEAM_SIZE=5
# Keep false. Per-speaker tracks are mostly silence, and carrying context across
# those gaps is what makes Whisper loop the same sentence over and over.
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
# Voice-activity padding, in ms. Raise to ~800 if short words get clipped.
WHISPER_VAD_MIN_SILENCE_MS=500
# Extra vocabulary fed to Whisper as a prompt, on top of the character names
# from /character set. Put your campaign's proper nouns here - this is the
# single biggest win for getting names spelled right.
# WHISPER_PROMPT_EXTRA=Yer isimleri: Neverwinter, Waterdeep. NPC: Volo, Xanathar.
# Drop subtitle-boilerplate hallucinations ("Altyazi M.K.", "Abone olmayi
# unutmayin") and stuck repetitions from the transcript.
FILTER_HALLUCINATIONS=true
# Each speaker track is transcribed in chunks of this many minutes. This is a
# memory ceiling, not a preference: faster-whisper loads whatever file it is
# given fully into memory (~33 MB per minute of audio), so an unchunked
# four-hour track would need ~8 GB. 10 min keeps peak usage near 350 MB.
# Set 0 to disable (only sane for very short sessions).
TRANSCRIBE_CHUNK_MINUTES=10

# --- Storage ----------------------------------------------------------------
# Host directory holding sessions, transcripts, exports and the database.
# Defaults to ./data next to this file. Audio needs roughly 0.7 GB per hour
# PER SPEAKER (a 4h session with 5 players is ~14 GB, kept for
# AUDIO_RETENTION_DAYS), so put this on a disk with real space.
# It must be writable by uid 10001: sudo chown -R 10001:10001 <dir>
DATA_HOST_DIR=./data

# Path *inside* the container. Leave this alone; DATA_HOST_DIR is the one to change.
DATA_DIR=/data
# wav (no re-encode, larger) or mp3 (smaller, needs ffmpeg transcode).
AUDIO_FORMAT=wav
# Raw audio is deleted this many days after a successful transcription.
AUDIO_RETENTION_DAYS=7
# Warn when free space on DATA_DIR drops below this. Keep it above the size of
# one session (see the storage note above) or the warning arrives too late.
DISK_WARNING_THRESHOLD_MB=20000
# Fallback DM target for disk warnings and fatal startup errors.
ADMIN_USER_ID=
# Exports larger than this are reported as a server path instead of uploaded.
EXPORT_MAX_DISCORD_UPLOAD_MB=25

# --- Transcription queue ----------------------------------------------------
# Transcription only runs inside this window, one job at a time.
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=00:00
QUIET_HOURS_END=08:00
TIMEZONE=Europe/Istanbul

# --- Backups ----------------------------------------------------------------
# Daily bot.db copies kept in /data/backups.
DB_BACKUP_KEEP_DAYS=14

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# Container clock for log timestamps. Without it logs are in UTC. Transcript
# timestamps use TIMEZONE above regardless of this setting.
TZ=Europe/Istanbul
